# ==============================================================================
# ResearchAI — Multi-Provider API Configuration (.env.example)
# Copy this file to .env and fill in the keys for the provider(s) you use.
# Priority: Sidebar Input -> .streamlit/secrets.toml -> .env -> OS Environment
# ==============================================================================

# 1. OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# 2. Google Gemini (https://aistudio.google.com/app/apikey — Free tier available)
GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# 3. Groq (https://console.groq.com/keys — Fast free tier available)
GROQ_API_KEY=""

# 4. Custom OpenAI-Compatible API (OpenRouter, DeepSeek, Together, Ollama, LM Studio, etc.)
CUSTOM_API_KEY=""
CUSTOM_BASE_URL="https://openrouter.ai/api/v1"
CUSTOM_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Optional researcher metadata defaults
DEFAULT_RESEARCH_FIELD="Artificial Intelligence & Computational Science"
DEFAULT_CITATION_STYLE="APA"
